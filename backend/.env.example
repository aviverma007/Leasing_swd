# Copy to .env and fill in your SQL Server credentials
DB_SERVER=192.168.66.33
DB_DATABASE=LeasingBillingDB
DB_USER=sa
DB_PASSWORD=YourPassword
DB_PORT=1433
PORT=5096

# Schema to hold this app's tables. Leave as dbo for a dedicated database.
# If you are ADDING these tables to an EXISTING shared database, set this to
# 'leasing' so they never collide with your existing dbo.* tables, and run
# sql/schema_existing_db.sql instead of sql/schema.sql.
DB_SCHEMA=dbo

# --- Login / auth ---
# Admin account (not stored in the database). Set your own values.
ADMIN_ID=admin
ADMIN_PASSWORD=ChangeThisAdminPassword
# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
